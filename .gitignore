# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data.
# Note: In this specific project, we are using terraform.tfvars for demo, 
# but usually it's ignored. I will keep it commented out or included if the user wants it.
# For now, I'll follow standard practice and ignore it, but the user specifically asked for it in the previous step.
# Actually, I'll keep the user's files and just ignore the common ones.

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Custom ignores
node_modules/
*.exe
.terraform.lock.hcl
